# ─────────────────────────────────────────────
# Anthropic
# 获取方式：注册后前往 https://console.anthropic.com/settings/keys 创建 API Key
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─────────────────────────────────────────────
# Brave Search  （web_search 工具 + 健康预警监控）
# 获取方式：注册后前往 https://api.search.brave.com 创建 API Key（有免费层）
# ─────────────────────────────────────────────
BRAVE_API_KEY=

# ─────────────────────────────────────────────
# Mem0  （向量记忆层）
# 获取方式：注册后前往 https://app.mem0.ai/dashboard/api-keys 创建 API Key
# 也可本地自托管，参考 https://docs.mem0.ai/open-source/quickstart
# ─────────────────────────────────────────────
MEM0_API_KEY=

# ─────────────────────────────────────────────
# Zep  （时序知识图谱层，基于 Graphiti）
# 获取方式：注册后前往 https://app.getzep.com/projects 创建项目，在项目设置中复制 API Key
# 也可本地自托管，参考 https://help.getzep.com/deployment/quickstart
# ─────────────────────────────────────────────
ZEP_API_KEY=

# ─────────────────────────────────────────────
# Redis  （会话短期记忆缓冲）
# 本地运行：docker compose up redis 后使用以下默认值即可
# 云托管推荐：https://upstash.com （有免费层）
# 注意：Upstash 用 rediss:// 协议，格式为 rediss://default:<PASSWORD>@<HOST>:6380
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
SESSION_TTL_SECONDS=3600
MAX_HISTORY_MESSAGES=10

# memory_search 冷却机制
# 冷却轮数 = MAX_HISTORY_MESSAGES // 2，调整上面的值即可同步生效
# MEM_SEARCH_COOLDOWN_TTL_SECONDS: 冷却的最长时间，超时后自动重新检索（与轮数独立生效）
MEM_SEARCH_COOLDOWN_TTL_SECONDS=1800

# ─────────────────────────────────────────────
# Auth — JWT 签名密钥
# 生成方式（任选其一）：
#   python -c "import secrets; print(secrets.token_hex(32))"
#   openssl rand -hex 32
# 生产环境务必替换，切勿使用默认值
# ─────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ─────────────────────────────────────────────
# Neo4j  （知识图谱存储，供 Zep/Graphiti 使用）
# 本地运行：docker compose up neo4j 后使用以下默认值即可，浏览器访问 http://localhost:7474
# 云托管：https://neo4j.com/cloud/aura-free （免费层，复制连接 URI 和密码）
# ─────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ─────────────────────────────────────────────
# Qdrant  （向量数据库，供 Mem0 存储 embedding）
# 本地运行：docker compose up qdrant 后使用以下默认值即可，控制台 http://localhost:6333/dashboard
# 云托管：https://cloud.qdrant.io （免费 1GB cluster，复制 Cluster URL 粘贴此处）
# ─────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
# search_rag 工具直连 gRPC 端口，默认 6334（与 docker-compose 一致）
QDRANT_HOST=localhost
QDRANT_PORT=6334
