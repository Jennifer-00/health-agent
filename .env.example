# ─────────────────────────────────────────────
# 代理（可选）— 国内网络访问 mem0/Brave/Anthropic 等境外 API 时填写
# 端口对应 VPN 客户端的本地 HTTP 代理：Clash=7890, v2rayN=10809
# 留空则直连
# ─────────────────────────────────────────────
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1

# ─────────────────────────────────────────────
# OpenAI
# 获取方式：注册后前往 https://platform.openai.com/api-keys 创建 API Key
# ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─────────────────────────────────────────────
# DeepSeek  （OpenAI 兼容接口，用于 Mem0 记忆提取 LLM）
# 获取方式：https://platform.deepseek.com/api_keys
# MEM0_LLM_MODEL 默认 deepseek-chat，可改为 deepseek-reasoner
# ─────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-...
MEM0_LLM_MODEL=deepseek-chat

# ─────────────────────────────────────────────
# Brave Search  （web_search 工具 + 健康预警监控）
# 获取方式：注册后前往 https://api.search.brave.com 创建 API Key（有免费层）
# ─────────────────────────────────────────────
BRAVE_API_KEY=

# ─────────────────────────────────────────────
# Mem0  （OSS 本地模式，无需 API Key）
# LLM 使用 ANTHROPIC_API_KEY，Embedder 使用 BAAI/bge-m3，向量库复用 Qdrant
# MEM0_COLLECTION：Qdrant 中存储记忆的 collection 名称
# ─────────────────────────────────────────────
MEM0_COLLECTION=health_memories

# ─────────────────────────────────────────────
# Zep  （时序知识图谱层，基于 Graphiti）
# 获取方式：注册后前往 https://app.getzep.com/projects 创建项目，在项目设置中复制 API Key
# 也可本地自托管，参考 https://help.getzep.com/deployment/quickstart
# ─────────────────────────────────────────────
ZEP_API_KEY=

# ─────────────────────────────────────────────
# Redis  （会话短期记忆缓冲）
# 本地运行：docker compose up redis 后使用以下默认值即可
# 云托管推荐：https://upstash.com （有免费层）
# 注意：Upstash 用 rediss:// 协议，格式为 rediss://default:<PASSWORD>@<HOST>:6380
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
SESSION_TTL_SECONDS=3600
MAX_HISTORY_MESSAGES=10

# 对话轮次本地兜底 DB（SQLite），用于 Redis pending 队列丢失时恢复记忆
# 留空则使用默认路径 data/turns.db
TURN_STORE_PATH=data/turns.db

# Mem0 add() 内部相似记忆查找的复合重排权重
# final_score = W_SIM * similarity + W_REC * recency_decay + W_IMP * importance
RANK_W_SIM=0.6
RANK_W_REC=0.25
RANK_W_IMP=0.15
RANK_HALF_LIFE_DAYS=30   # 时间半衰期（天），30天后 recency 权重降至 0.5
RANK_OVERSAMPLE=4        # 超采样倍数，fetch N 倍候选再重排
GRAPH_NODES_PER_ENTITY=2  # 每个实体取相似度最高的前 N 个节点，全量取其三元组

# memory_search 冷却机制
# 冷却轮数 = MAX_HISTORY_MESSAGES // 2，调整上面的值即可同步生效
# MEM_SEARCH_COOLDOWN_TTL_SECONDS: 冷却的最长时间，超时后自动重新检索（与轮数独立生效）
MEM_SEARCH_COOLDOWN_TTL_SECONDS=1800

# ─────────────────────────────────────────────
# Auth — JWT 签名密钥
# 生成方式（任选其一）：
#   python -c "import secrets; print(secrets.token_hex(32))"
#   openssl rand -hex 32
# 生产环境务必替换，切勿使用默认值
# ─────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ─────────────────────────────────────────────
# 登录账号（演示用单用户模式）
# ─────────────────────────────────────────────
DEMO_EMAIL=demo@health.ai
DEMO_PASSWORD=demo123

# ─────────────────────────────────────────────
# Neo4j  （Mem0 图记忆存储）
# 本地运行：docker compose up neo4j 后使用以下默认值即可，浏览器访问 http://localhost:7474
# 云托管：https://neo4j.com/cloud/aura-free （免费层，复制连接 URI 和密码）
# ─────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ─────────────────────────────────────────────
# Qdrant  （向量数据库，供 Mem0 存储 embedding）
# 本地运行：docker compose up qdrant 后使用以下默认值即可，控制台 http://localhost:6333/dashboard
# 云托管：https://cloud.qdrant.io （免费 1GB cluster，复制 Cluster URL 粘贴此处）
# ─────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
# search_rag 工具直连 gRPC 端口，默认 6334（与 docker-compose 一致）
QDRANT_HOST=localhost
QDRANT_PORT=6334
